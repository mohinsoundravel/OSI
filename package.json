{
  "name": "osi-global-monitor",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time OSINT globe with a scheduled alert poller for Indian disaster warnings.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test poller/test/*.test.mjs",
    "check": "node --check src/app.js && node --check sw.js && node scripts/check-syntax.mjs",
    "poll": "node poller/index.mjs --data-dir data",
    "poll:dry": "node poller/index.mjs --data-dir data --dry-run",
    "poll:fixtures": "node poller/index.mjs --data-dir .tmp/data --config poller/test/monitor.test-config.json --fixtures poller/test/fixtures --dry-run --now 2026-10-23T06:00:00Z",
    "build:normals": "node poller/build-heat-normals.mjs --data-dir data",
    "serve": "python3 -m http.server 8080"
  }
}
